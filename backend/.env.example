# DINOS Pizzaria API - Environment Configuration Example

# Application
APP_NAME=DINOS Pizzaria API
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./dinos_pizzaria.db
SQL_ECHO=False

# Security & JWT Auth
SECRET_KEY=dinos-super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Seed
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=dinos_admin_2026

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
